{
  "hosting": [
    {
      "target": "simas-demo-5ead3",
      "public": "dist-hosting",
      "ignore": [
        "firebase.json",
        "firebase-*.json",
        "**/.*",
        "!.well-known/**",
        ".git/**",
        ".github/**",
        ".agents/**",
        ".vscode/**",
        "android-twa/**",
        "cloudflare/**",
        "functions/**",
        "supabase/**",
        "scratch/**",
        "scripts/**",
        "sql/**",
        "docs/**",
        "backup/**",
        "cypress/**",
        "cypress.config.js",
        "node_modules/**",
        "**/node_modules/**",
        "package.json",
        "package-lock.json",
        "school*.json",
        "**/*.docx",
        "**/*.doc",
        "redirect-stub/**",
        "pub/kirim_kapsul_waktu.gs",
        "screenshot.png",
        "users.csv",
        "firestore.rules",
        "firestore.indexes.json",
        "firestore-debug.log",
        "firebase-debug.log",
        "deploy.log",
        "*.md",
        "*.log",
        "*.sql",
        "*.csv",
        "*.pdf",
        "*.key",
        "*.pem",
        "*.keystore",
        "*.jks",
        "*.env*",
        ".env*",
        "tailwind.config.js",
        "tailwind.duta.config.js",
        "css/tailwind.src.css",
        "tests/**",
        "templates/**",
        "google-apps-script/**",
        "dist-hosting/**",
        ".hosting-history/**",
        ".dist-hosting-build-*/**",
        "PRD_SIMAS.docx",
        "**/~$*",
        "Rekap_Absen_*",
        "**/*.test.*",
        "**/*.spec.*",
        ".claude/**",
        ".codex/**",
        ".gemini/**",
        ".firebase/**",
        ".wrangler/**",
        "**/*.md",
        "**/*.log",
        "**/*.sql",
        "**/*.csv",
        "**/*.key",
        "**/*.pem",
        "**/*.keystore",
        "**/*.jks",
        "**/*.env*",
        "**/*.pdf",
        "**/*.LICENSE",
        "**/*.license*"
      ],
      "headers": [
        {
          "source": "/.well-known/**",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/json"
            },
            {
              "key": "Access-Control-Allow-Origin",
              "value": "*"
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600"
            }
          ]
        },
        {
          "source": "**/*.@(js|mjs|css|html|json)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "/@(sw.js|sw-manifest.js|push-worker.js|firebase-messaging-sw.js)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            },
            {
              "key": "Pragma",
              "value": "no-cache"
            },
            {
              "key": "Expires",
              "value": "0"
            }
          ]
        },
        {
          "regex": "^/?.*\\.[a-f0-9]{16}\\.(js|mjs|css)$",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**/*.@(png|jpg|jpeg|gif|webp|svg|ico|woff2|woff|ttf|otf|mp4|webm|mp3|wav|ogg|pdf)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=2592000, immutable"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://apis.google.com https://accounts.google.com https://cdn.tailwindcss.com https://cdnjs.cloudflare.com https://www.gstatic.com https://www.googletagmanager.com https://cdn.jsdelivr.net https://unpkg.com https://cdn.sheetjs.com https://www.youtube.com https://*.firebaseapp.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://fonts.googleapis.com; font-src 'self' https://cdnjs.cloudflare.com https://fonts.gstatic.com;connect-src 'self' https://simas-smagesa-api.komangpurna1.workers.dev https://*.workers.dev https://wwvtthoeknizglicrhor.supabase.co https://*.supabase.co wss://*.supabase.co https://*.firebaseio.com wss://*.firebaseio.com https://*.googleapis.com https://apis.google.com https://accounts.google.com https://*.firebaseapp.com https://*.google-analytics.com https://*.analytics.google.com https://analytics.google.com https://stats.g.doubleclick.net https://*.firebasestorage.app https://www.gstatic.com https://cdn.tailwindcss.com https://cdnjs.cloudflare.com https://fonts.gstatic.com https://cdn.jsdelivr.net https://unpkg.com https://www.googletagmanager.com https://cdn.sheetjs.com https://script.google.com https://script.googleusercontent.com https://*.googleusercontent.com https://api.qrserver.com https://openlibrary.org https://api-hari-libur.vercel.app https://simas-demo-5ead3.web.app https://simas-demo-5ead3.firebaseapp.com; img-src 'self' data: blob: https:; manifest-src 'self' blob:;frame-src 'self' https://drive.google.com https://docs.google.com https://accounts.google.com https://apis.google.com https://*.firebaseapp.com https://simas-demo-5ead3.web.app https://www.youtube.com https://www.youtube-nocookie.com https://simas-demo-5ead3.firebaseapp.com;"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "SAMEORIGIN"
            },
            {
              "key": "X-XSS-Protection",
              "value": "1; mode=block"
            },
            {
              "key": "Strict-Transport-Security",
              "value": "max-age=31536000; includeSubDomains"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(self), microphone=(), geolocation=(self), payment=(), usb=()"
            }
          ]
        }
      ],
      "predeploy": [
        "node scripts/restore-hosting-history.mjs --site simas-demo-5ead3",
        "node scripts/build-hosting.mjs",
        "node scripts/check-hosting-build.mjs"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8085
    },
    "ui": {
      "enabled": true,
      "port": 4000
    }
  }
}
