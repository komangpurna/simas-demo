# SIMAS SMAGESA - Environment Variables Configuration
# File .env sudah dimasukkan ke .gitignore agar data rahasia tidak ter-commit ke Git.

# ====================================================
# 1. AKUN UTAMA / DEFAULT (Otomatis dipakai jika role tak ditentukan)
# ====================================================
TEST_USER_IDENTITY=
TEST_USER_PASSWORD=

# ====================================================
# 2. AKUN PER-ROLE (Isi role yang ingin diuji oleh AI/DevTools)
# ====================================================

# Akun Admin / Super Admin / Pengelola Sistem
TEST_ADMIN_IDENTITY=
TEST_ADMIN_PASSWORD=

# Akun Guru (Wali Kelas / Guru Mapel / BK / Wakasek)
TEST_GURU_IDENTITY=
TEST_GURU_PASSWORD=

# Akun Siswa (Login via NIS + Tanggal Lahir YYYY-MM-DD, atau opsional NISN)
TEST_SISWA_NIS=
TEST_SISWA_TGL_LAHIR=
TEST_SISWA_NISN=
