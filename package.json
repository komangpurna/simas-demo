{
  "name": "smagesa-simas",
  "version": "26.11.02.1",
  "description": "SIMAS SMAGESA - Client-side Testing Environment",
  "scripts": {
    "school:prepare": "node scripts/prepare-school.mjs",
    "sync:version": "node scripts/sync-version.js",
    "check:version": "node scripts/sync-version.js --check",
    "check:syntax": "node scripts/sync-version.js && node scripts/check-syntax.js",
    "migrate:ews-config": "node scripts/migrate-ews-config-to-d1.js",
    "check:worker": "node scripts/check-worker-modules.mjs",
    "pretest:unit": "node scripts/sync-version.js && node scripts/check-syntax.js && node scripts/check-worker-modules.mjs",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:unit:changed": "node --experimental-vm-modules node_modules/jest/bin/jest.js --onlyChanged",
    "test:worker:smoke": "node scripts/worker-smoke.mjs",
    "test:rules:profile": "firebase emulators:exec --only firestore --project demo-simas-profile-rules \"node scripts/test-firestore-profile-rules.cjs\"",
    "test:e2e": "cypress run",
    "test:e2e:interactive": "cypress open",
    "serve": "http-server . -p 8080",
    "build:css": "tailwindcss -c tailwind.config.js -i css/tailwind.src.css -o css/tailwind.css && tailwindcss -c tailwind.duta.config.js -i css/tailwind.src.css -o css/tailwind-duta.css",
    "watch:css": "tailwindcss -c tailwind.config.js -i css/tailwind.src.css -o css/tailwind.css --watch",
    "emulate:test": "firebase emulators:exec --import=cypress/fixtures/emulator-data --project smagesa \"http-server . -p 8080 & npx wait-on http://localhost:8080 && npm run test:e2e\"",
    "deploy:worker": "node scripts/deploy-worker-api.js",
    "build:hosting": "node scripts/build-hosting.mjs",
    "check:hosting": "node scripts/check-hosting-build.mjs",
    "test:sw": "node --test tests/service-worker-runtime.test.cjs",
    "restore:hosting:history": "node scripts/restore-hosting-history.mjs",
    "deploy:staging": "node scripts/deploy-staging.cjs",
    "deploy:production": "node scripts/deploy-production.cjs",
    "export:prd:docx": "node scripts/export-prd-to-docx.js"
  },
  "devDependencies": {
    "acorn": "^8.17.0",
    "acorn-walk": "^8.3.5",
    "cypress": "^13.13.0",
    "esbuild": "^0.28.1",
    "firebase-tools": "^13.29.1",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "tailwindcss": "^3.4.17",
    "wait-on": "^7.2.0",
    "wrangler": "^4.130.0",
    "parse5": "^7.3.0"
  },
  "jest": {
    "maxWorkers": 2,
    "workerIdleMemoryLimit": "384MB",
    "setupFiles": [
      "<rootDir>/tests/helpers/worker-source-setup.cjs"
    ],
    "testMatch": [
      "**/__tests__/**/*.[jt]s?(x)",
      "**/?(*.)+(spec|test).[tj]s?(x)",
      "**/?(*.)+(spec|test).mjs"
    ],
    "moduleFileExtensions": [
      "js",
      "mjs",
      "json",
      "jsx",
      "node"
    ]
  },
  "dependencies": {
    "docx": "^9.8.1",
    "file-saver": "^2.0.5"
  }
}
